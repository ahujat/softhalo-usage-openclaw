{
  "name": "softhalo-usage-openclaw",
  "version": "0.2.0",
  "description": "OpenClaw plugin: records token usage to a local folder for the Soft Halo desktop app.",
  "license": "MIT",
  "type": "module",
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "compat": {
